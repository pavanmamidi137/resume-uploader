# ---------------------------------------------------------------------------
# Resume Portal — environment template
# Copy to `.env` for local development, and replicate every key on Render
# (Dashboard -> Service -> Environment) with the same values.
# ---------------------------------------------------------------------------

# Django secret key. Use a long random string in production:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-insecure-change-me

# Must be 0 in production. 1 enables debug pages + static serving.
DEBUG=0

# Comma-separated hostnames allowed to serve the site.
# On Render, the public hostname is added automatically — no need to list it.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to POST over HTTPS (login/uploads). Comma-separated:
CSRF_TRUSTED_ORIGINS=

# Supabase Postgres connection string. Percent-encode special chars in the
# password (e.g. MyPass@123 -> MyPass%40123).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# REAL service-role key from Supabase Dashboard -> Project Settings -> API.
# Storage upload/download is only enabled when this is a real key
# (the string "service-role-placeholder" disables Supabase storage).
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name used for resume PDFs (create it in Supabase Storage).
SUPABASE_STORAGE_BUCKET=resumes

# Optional: 1 forces HTTPS redirect when DEBUG=0 (default 1).
SECURE_SSL_REDIRECT=1
